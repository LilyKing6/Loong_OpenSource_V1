// 测试文件：验证词法分析器和语法分析器的改进

程序 {
    // 测试中文关键字
    如果 (真) {
        打印("Hello, 中文编程!");
    } 否则 {
        打印("条件不满足");
    }

    // 测试变量和运算符
    整数 x = 10;
    实数 y = 3.14;
    字符串 msg = "测试字符串";

    // 测试函数调用
    打印(x + y);
    打印(msg);

    // 测试循环
    对于 (整数 i = 0; i < 5; i = i + 1) {
        打印(i);
    }

    // 测试数组
    整数[] arr = [1, 2, 3, 4, 5];
    打印(arr[0]);

    返回 0;
}